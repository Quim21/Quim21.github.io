---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { profile, stack } from '../data/profile';
import { featured, more } from '../data/projects';

const title = `${profile.name} · Portafolio`;
const description = `${profile.role}. ${profile.tagline}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href="#top" class="brand">quim<span>21</span></a>
        <nav aria-label="Secciones">
          <a href="#proyectos">Proyectos</a>
          <a href="#stack">Stack</a>
          <a href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero wrap">
        <p class="eyebrow">Hola, soy</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#proyectos">Ver proyectos</a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </section>

      <section id="proyectos" class="wrap section">
        <h2 class="section-title">Proyectos destacados</h2>

        <div class="featured">
          {
            featured.map((p, i) => (
              <article class={`feature ${i % 2 ? 'flip' : ''}`}>
                <div class="visual">
                  {p.visual.type === 'image' ? (
                    <Image src={p.visual.src} alt={p.visual.alt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 520px" loading={i === 0 ? 'eager' : 'lazy'} />
                  ) : (
                    <div class={`code ${p.visual.type}`} aria-hidden="true">
                      <div class="code-bar">
                        <span class="dot" />
                        <span class="dot" />
                        <span class="dot" />
                        <span class="code-title">{p.visual.title}</span>
                      </div>
                      <pre>{p.visual.lines.join('\n')}</pre>
                    </div>
                  )}
                </div>

                <div class="body">
                  <p class="kind">{p.kind}{p.credits && <span class="credits"> · {p.credits}</span>}</p>
                  <h3>{p.title}</h3>
                  <p class="summary">{p.summary}</p>
                  <ul class="highlights">
                    {p.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                  <ul class="tags" aria-label="Tecnologías">
                    {p.stack.map((s) => <li>{s}</li>)}
                  </ul>
                  <div class="links">
                    {p.demo &&
                      (p.demo.startsWith('/') ? (
                        <a class="play" href={p.demo}>▶ {p.demoLabel ?? 'Demo'}</a>
                      ) : (
                        <a class="play" href={p.demo} target="_blank" rel="noopener">▶ {p.demoLabel ?? 'Demo'} ↗</a>
                      ))}
                    {p.repo ? (
                      <a href={p.repo} target="_blank" rel="noopener">Código ↗</a>
                    ) : (
                      <span class="private">🔒 Código privado · disponible bajo petición</span>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <h2 class="section-title small">Otros proyectos</h2>
        <div class="grid">
          {
            more.map((p) => (
              <article class="card">
                <p class="kind">{p.kind}</p>
                <h3>{p.title}</h3>
                <p class="summary">{p.summary}</p>
                <ul class="tags" aria-label="Tecnologías">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <div class="links">
                  <a href={p.repo} target="_blank" rel="noopener">Código ↗</a>
                  {p.demo && <a href={p.demo} target="_blank" rel="noopener">Demo ↗</a>}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="stack" class="wrap section">
        <h2 class="section-title">Stack</h2>
        <div class="stack">
          {
            stack.map((g) => (
              <div class="stack-group">
                <h3>{g.group}</h3>
                <ul class="tags">
                  {g.items.map((s) => <li>{s}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section id="contacto" class="wrap section contact">
        <h2 class="section-title">Contacto</h2>
        <p>¿Tienes una propuesta de prácticas, un proyecto o una pregunta? Escríbeme.</p>
        <div class="cta">
          {profile.email && <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>}
          {profile.linkedin && <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
          <a class={`btn ${profile.email ? '' : 'primary'}`} href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <p>© {year} {profile.name} · Hecho con Astro</p>
    </footer>
  </body>
</html>

<style>
  /* Navegación */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    font-family: var(--mono);
    font-weight: 500;
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  .nav nav {
    display: flex;
    gap: 22px;
  }
  .nav nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
  }
  .nav nav a:hover {
    color: var(--text);
  }

  /* Portada */
  .hero {
    padding: 96px 0 72px;
  }
  .eyebrow {
    font-family: var(--mono);
    color: var(--accent);
    margin: 0 0 8px;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .role {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    color: var(--muted);
    font-weight: 600;
    margin: 10px 0 20px;
  }
  .tagline {
    max-width: 640px;
    color: var(--muted);
    font-size: 1.08rem;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  @media (prefers-color-scheme: dark) {
    .btn.primary {
      color: #120c24;
    }
  }

  /* Secciones */
  .section {
    padding: 56px 0;
  }
  .section-title {
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
  }
  .section-title.small {
    font-size: 1.3rem;
    margin-top: 64px;
  }

  /* Proyectos destacados */
  .featured {
    display: grid;
    gap: 28px;
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: center;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .feature.flip .visual {
    order: 2;
  }
  .visual img {
    border-radius: 10px;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .code {
    background: var(--code-bg);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .code-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3648;
  }
  .code-title {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--code-dim);
  }
  .code pre {
    margin: 0;
    padding: 16px 18px 20px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--code-text);
    overflow-x: auto;
  }
  .code.terminal pre {
    font-size: 11.5px;
  }

  .kind {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    margin: 0 0 6px;
  }
  .credits {
    color: var(--muted);
  }
  h3 {
    font-size: 1.45rem;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  .summary {
    color: var(--muted);
    margin: 0 0 16px;
  }
  .highlights {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .highlights li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
  }
  .highlights li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 1px;
    font-size: 10px;
    color: var(--accent);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 18px;
  }
  .links a {
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 1px;
  }
  .links a:hover {
    color: var(--accent);
  }
  .links {
    flex-wrap: wrap;
    align-items: center;
  }
  .links a.play {
    border: none;
    padding: 6px 14px;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
  }
  .links a.play:hover {
    color: #fff;
    filter: brightness(1.1);
  }
  @media (prefers-color-scheme: dark) {
    .links a.play,
    .links a.play:hover {
      color: #120c24;
    }
  }
  .private {
    font-size: 14px;
    color: var(--muted);
    padding: 5px 12px;
    border: 1px dashed var(--border);
    border-radius: 999px;
  }

  /* Otros proyectos */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card h3 {
    font-size: 1.2rem;
  }
  .card .summary {
    flex: 1;
    font-size: 15px;
  }

  /* Stack */
  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .stack-group {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .stack-group h3 {
    font-size: 1rem;
    margin-bottom: 14px;
  }
  .stack-group .tags {
    margin: 0;
  }

  /* Contacto y pie */
  .contact p {
    color: var(--muted);
    margin: 0;
  }
  .contact .cta {
    margin-top: 20px;
  }
  .footer {
    padding: 32px 0 48px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }
  .footer p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding: 18px;
    }
    .feature.flip .visual {
      order: 0;
    }
    .hero {
      padding: 64px 0 48px;
    }
  }
  @media (max-width: 480px) {
    .nav nav {
      gap: 14px;
    }
    .nav nav a {
      font-size: 14px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
